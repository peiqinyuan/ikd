<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Ikd.Cli</RootNamespace>
    <AssemblyName>ikd</AssemblyName>
    <AssemblyTitle>ikd programming language compiler and VM</AssemblyTitle>
    <Version>0.1.0</Version>
    <InformationalVersion>0.1.0</InformationalVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Description>ikd language compiler / VM</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ikd.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ikd.Compiler\Ikd.Compiler.csproj" />
    <ProjectReference Include="..\Ikd.Runtime\Ikd.Runtime.csproj" />
  </ItemGroup>

</Project>
