pub class Rect {
    let w: Float;
    let h: Float;

    init(w, h) {
        this.w = w;
        this.h = h;
    }
}

pub enum Kind {
    Rect,
    Circle,
}

pub fn areaOf(r) {
    return r.w * r.h;
}

pub fn describe(k) {
    return match k {
        Kind.Rect => "rect",
        _ => "other",
    };
}
