macro PI = 3.14;
macro MAX(a, b) {
    if (a > b) { a } else { b }
}
macro SUM3(a, b, c) {
    let s = a + b;
    s + c
}

println("PI=${PI}");
println(MAX(3, 7));
println(MAX(10, 4));
println(SUM3(1, 2, 3));

fn demo(n: Int): Int {
    let local = 100;
    return MAX(local, n * 2);
}
println(demo(9));
println(demo(60));

for i in range(0, 3) {
    println(SQUARE(i));
}

macro SQUARE(x) { x * x }

println(sizeof(Int));
println(sizeof(Float));
println(sizeof(Bool));
println(sizeof(Str));
println(sizeof(List));
println(sizeof(Map));
println(sizeof(null));

let xs = [1, 2, 3, 4];
println(sizeof(xs));
println(len(xs));
